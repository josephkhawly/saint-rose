{
  "name": "saint_rose",
  "version": "1.0.0",
  "description": "saint_rose",
  "type": "module",
  "scripts": {
    "dev": "portless saint-rose next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed": "tsx --env-file=.env.local src/scripts/seed.ts",
    "migrate:media": "tsx --env-file=.env.local src/scripts/migrate-media.ts --export ./selected-rows.json",
    "backfill:blur": "tsx --env-file=.env.local src/scripts/backfill-blur.ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "24.0.10",
    "@types/react": "19.2.17",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@next/third-parties": "16.2.9",
    "@payloadcms/db-vercel-postgres": "^3.86.0",
    "@payloadcms/live-preview-react": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/plugin-seo": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/storage-vercel-blob": "^3.86.0",
    "@payloadcms/ui": "^3.86.0",
    "@plaiceholder/next": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "classnames": "^2.5.1",
    "formidable": "^2.1.5",
    "graphql": "^16.14.2",
    "lenis": "^1.3.23",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "node-fetch": "^2.7.0",
    "payload": "^3.86.0",
    "plaiceholder": "^3.0.0",
    "postcss": "^8.5.15",
    "postmark": "^3.11.0",
    "react": "19.2.7",
    "react-awesome-reveal": "^4.3.1",
    "react-dom": "19.2.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ]
}
